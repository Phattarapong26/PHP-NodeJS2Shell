# OPScaner Production Environment Configuration
# Environment: 'production' or 'development'
OPSCANER_ENV=production

# Server Port
PORT=5050

# Secure Session Secret (Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))')
FLASK_SECRET=

# Allowed CORS Origins (Comma-separated, e.g., http://localhost:5050,https://scan.internal.corp)
OPSCANER_CORS_ORIGINS=http://127.0.0.1:5050,http://localhost:5050

# Test Lab Endpoints (1=Enabled for developer/CI testing, 0=Disabled for production)
OPSCANER_ENABLE_TEST_LAB=0

# Custom CVE Database Feed JSON Path (Optional)
OPSCANER_CVE_FEED_PATH=

# Network Overrides (Optional - automatically detected from system route table if omitted)
# HOST_IP=
# HOST_SUBNET=
# HOST_GATEWAY=
# HOST_INTERFACE=
