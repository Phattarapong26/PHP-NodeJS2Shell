#!/bin/sh
# wrapper: ค่า sysctl ที่เกี่ยวกับ CVE-2026-98432 (ค่าจริงอยู่ในโปรไฟล์)
. /etc/lab-kernel.env 2>/dev/null || true
KEY="$2"
[ "$1" = "-n" ] || KEY="$1"
case "$KEY" in
  net.mptcp.enabled)         echo "${FAKE_MPTCP:-1}"; exit 0 ;;
  net.ipv4.tcp_migrate_req)  echo "${FAKE_MIGRATE:-0}"; exit 0 ;;
  kernel.osrelease)          echo "${FAKE_KREL:-}"; exit 0 ;;
  kernel.hostname)           echo "${FAKE_HOST:-}"; exit 0 ;;
esac
REAL=/usr/sbin/sysctl
[ -x "$REAL" ] || REAL=/sbin/sysctl
[ -x "$REAL" ] || REAL=/usr/bin/sysctl
[ -x "$REAL" ] && exec "$REAL" "$@" 
echo "sysctl: cannot stat /proc/sys/$(echo "$KEY" | tr . /): No such file or directory" >&2
exit 255
