#!/bin/sh
DIR="$(cd "$(dirname "$0")/.." && pwd)"
. "$DIR/lab-kernel.env" 2>/dev/null || true
case "$1" in
  -r) echo "${FAKE_KREL}" ;;
  -v) echo "${FAKE_KVER}" ;;
  -n) echo "${FAKE_HOST}" ;;
  -a) echo "Linux ${FAKE_HOST} ${FAKE_KREL} ${FAKE_KVER} x86_64 x86_64 GNU/Linux" ;;
  -s) echo Linux ;;
  -m) echo x86_64 ;;
  *)  echo "Linux ${FAKE_HOST} ${FAKE_KREL} ${FAKE_KVER} x86_64 x86_64 GNU/Linux" ;;
esac
